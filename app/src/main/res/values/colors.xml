    <!--
      ── Quran night reading theme ──────────────────────────────────────────
      Deliberately its own palette rather than values-night: the reader's night mode is an
      in-app switch, so it must work whatever the system dark-mode setting is. Deep slate
      surfaces (#1A1D24) with warm, low-contrast cream and gold type: nothing here is
      pure white on pure black, which is what makes long night reading tiring.
    -->
    <color name="quranNightPaper">#1A1D24</color>
    <color name="quranNightSurface">#20242C</color>
    <color name="quranNightInk">#E7D9B4</color>
    <color name="quranNightBody">#D2C49F</color>
    <color name="quranNightMuted">#9A927E</color>
    <color name="quranNightLine">#2E333D</color>
    <color name="quranNightGreen">#8FBFA4</color>
    <color name="quranNightGreenDark">#BFD8C7</color>
    <color name="quranNightSoftGreen">#232A28</color>
    <color name="quranNightGold">#D9B36A</color>
    <color name="quranNightIconBar">#14161B</color>

    <!-- ── Home tiles: the Quran and the athkar get their own gold-framed, bigger tiles
      The clock/wallpaper tiles are 108dp rasters. These two are 140dp with a double gold
      frame, so the two "reading" entries stand apart from the two "design" entries. -->
    <color name="tileFrameGold">#C9A227</color>
    <color name="tileFrameGoldSoft">#8CC9A227</color>
    <color name="tileQuranTop">#0F3527</color>
    <color name="tileQuranBottom">#1F5E46</color>
