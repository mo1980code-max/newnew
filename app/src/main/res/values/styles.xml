<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Edge-to-edge is enforced from targetSdk 35; a white window background matches
             the list screens so the system-bar padding never shows a different colour. -->
        <item name="android:windowBackground">@color/textColor</item>
    </style>

    <!--
      Athkar reader: an opaque paper page, not a translucent sheet. The live wallpaper
      (mosque photographs) no longer shows through it, the dialog animation is gone and
      the window background is the same paper as the page, so the system-bar area that
      edge-to-edge exposes does not show a different colour. Light status-bar icons are
      set by UiCompat.applyEdgeToEdge(), which the activity calls for the insets.
    -->
    <style name="AppTheme.AthkarReader" parent="AppTheme">
        <item name="android:windowBackground">@color/athkarPaper</item>
        <item name="android:windowNoTitle">true</item>
    </style>



    <!--
      One tile of the home dashboard's top action bar: frosted glass, a 14 dp radius, soft
      elevation and a 46 dp target (44 dp is the accessibility minimum, and six of them still fit
      a 360 dp screen). Declared once so the six tiles can never drift apart.
    -->
    <style name="HomeGlassTile">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/bg_glass_tile</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:elevation">6dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- The Quran reader is an opaque, distraction-free paper page. -->
    <style name="AppTheme.QuranReader" parent="AppTheme">
        <item name="android:windowBackground">@color/quranPaper</item>
        <item name="android:windowNoTitle">true</item>
    </style>

</resources>
