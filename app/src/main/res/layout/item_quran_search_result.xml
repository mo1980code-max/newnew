<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_quran_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="15dp"
    android:paddingTop="11dp"
    android:paddingEnd="15dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/quranSearchResultType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_quran_tag"
        android:paddingStart="7dp"
        android:paddingTop="3dp"
        android:paddingEnd="7dp"
        android:paddingBottom="3dp"
        android:textColor="@color/quranGreenDark"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/quranSearchResultTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:textColor="@color/quranInk"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/quranSearchResultText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:lineSpacingExtra="4dp"
        android:maxLines="3"
        android:textColor="@color/quranBody"
        android:textDirection="anyRtl"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/quranSearchResultReference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:textColor="@color/quranMuted"
        android:textSize="12sp" />
</LinearLayout>
