<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:orientation="vertical">

    <!-- Top Toolbar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#161E2E"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            app:tint="#ffffff" />

        <TextView
            android:id="@+id/tvIndexTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/myfont"
            android:text="@string/quran_index_title"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnSearchToggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/quran_search_hint"
            android:padding="8dp"
            android:src="@drawable/ic_search"
            app:tint="#F59E0B" />
    </RelativeLayout>

    <!-- Collapsible Search Bar -->
    <LinearLayout
        android:id="@+id/layoutSearchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161E2E"
        android:paddingLeft="14dp"
        android:paddingTop="6dp"
        android:paddingRight="14dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/etSearchSurah"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/rounded_tasbih_card"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:hint="@string/quran_search_hint"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:singleLine="true"
            android:textColor="#ffffff"
            android:textColorHint="#8F9BB3"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Top CardView: Jump to Saved Bookmark -->
    <LinearLayout
        android:id="@+id/cardBookmark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/rounded_quran_card"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Bookmark"
            android:src="@drawable/ic_bookmark"
            app:tint="#F59E0B" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/myfont"
                android:text="@string/quran_saved_bookmark_title"
                android:textColor="#F59E0B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBookmarkDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="سورة الفاتحة • صفحة 1"
                android:textColor="#E6EDF3"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/quran_tab_selected"
            android:fontFamily="@font/myfont"
            android:paddingLeft="12dp"
            android:paddingTop="6dp"
            android:paddingRight="12dp"
            android:paddingBottom="6dp"
            android:text="@string/quran_resume_reading"
            android:textColor="#161E2E"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Custom Tabs (Surahs / Juz) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        android:background="#161E2E"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/btnTabSurahs"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/quran_tab_selected"
            android:fontFamily="@font/myfont"
            android:text="@string/quran_tab_surahs"
            android:textColor="#161E2E"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTabJuz"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:background="@drawable/quran_tab_unselected"
            android:fontFamily="@font/myfont"
            android:text="@string/quran_tab_juz"
            android:textColor="#8F9BB3"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Surahs RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSurahs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:scrollbars="vertical" />

    <!-- Juz RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvJuz"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:scrollbars="vertical"
        android:visibility="gone" />

</LinearLayout>
