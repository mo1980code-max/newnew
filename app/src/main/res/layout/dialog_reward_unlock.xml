<?xml version="1.0" encoding="utf-8"?>
<!--
  Explains what the rewarded video buys the user before anything is played.
  Google's rewarded-ad policy requires the reward to be described up front and a
  real opt-out to be available, so "Not now" is a first-class control here.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_reward_dialog"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingLeft="22dp"
    android:paddingTop="24dp"
    android:paddingEnd="22dp"
    android:paddingRight="22dp"
    android:paddingBottom="16dp">

    <ImageView
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_premium_badge"
        android:contentDescription="@string/premium_lock_content_description"
        android:padding="14dp"
        android:src="@drawable/ic_lock_gold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/myfont"
        android:gravity="center"
        android:text="@string/premium_dialog_title"
        android:textColor="@color/nativeAdText"
        android:textSize="20sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/premium_dialog_message"
        android:textColor="@color/nativeAdTextSecondary"
        android:textSize="14sp" />

    <Button
        android:id="@+id/rewardWatch"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_reward_button"
        android:drawableStart="@drawable/ic_play_reward"
        android:drawableLeft="@drawable/ic_play_reward"
        android:drawablePadding="8dp"
        android:fontFamily="@font/myfont"
        android:paddingStart="18dp"
        android:paddingLeft="18dp"
        android:paddingEnd="18dp"
        android:paddingRight="18dp"
        android:text="@string/premium_dialog_watch"
        android:textAllCaps="false"
        android:textColor="@color/goldVeryDark"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/rewardCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/premium_dialog_cancel"
        android:textColor="@color/nativeAdTextSecondary"
        android:textSize="14sp" />
</LinearLayout>
