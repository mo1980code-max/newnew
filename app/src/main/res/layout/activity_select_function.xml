<?xml version="1.0" encoding="utf-8"?>
<!-- Home dashboard. A ScrollView keeps all four primary tools reachable on small phones. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_backdrop"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="10dp">

        <!--
          The top action bar: six frosted-glass tiles over the gradient backdrop.

          Each tile is one 46 dp pane with a 14 dp radius, a hairline gold highlight and a soft
          elevation, holding a vector icon with a metallic accent. The bar scrolls with the
          dashboard, so on a short screen the tiles never steal room from the four cards. Press
          feedback (a scale dip) and the haptic tick are attached in MainActivity.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical|end"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/language"
                style="@style/HomeGlassTile"
                android:contentDescription="@string/cd_language"
                android:src="@drawable/ic_language" />

            <ImageView
                android:id="@+id/tasbeeh"
                style="@style/HomeGlassTile"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/cd_tasbeeh"
                android:src="@drawable/ic_tasbeeh" />

            <ImageView
                android:id="@+id/qibla"
                style="@style/HomeGlassTile"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/cd_qibla"
                android:src="@drawable/ic_qibla" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/privacy"
                style="@style/HomeGlassTile"
                android:contentDescription="@string/privacy_settings_content_description"
                android:src="@drawable/ic_privacy_shield"
                android:visibility="gone"
                app:tint="@color/glassIconIvory" />

            <ImageView
                android:id="@+id/rateus"
                style="@style/HomeGlassTile"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/cd_rate"
                android:src="@drawable/star"
                app:tint="@color/glassIconIvory" />

            <ImageView
                android:id="@+id/share"
                style="@style/HomeGlassTile"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/share_application"
                android:src="@drawable/ic_share"
                app:tint="@color/glassIconIvory" />
        </LinearLayout>

        <TextView
            android:id="@+id/homeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="20dp"
            android:fontFamily="@font/myfont"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/tileTitleGold"
            android:textSize="24sp" />

        <!-- The same ornamental divider the Quran tile uses, so title and tile belong together. -->
        <ImageView
            android:layout_width="128dp"
            android:layout_height="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_tile_divider"
            app:tint="@color/tileFrameGoldSoft" />

        <FrameLayout
            android:id="@+id/frameClock"
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="4dp"
            android:clickable="true"
            android:contentDescription="@string/tile_android_clock"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/big_" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/myfont"
                    android:gravity="center"
                    android:text="@string/tile_android_clock"
                    android:textColor="@color/textColor"
                    android:textSize="19sp" />

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:src="@drawable/clock_logo" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/frameWallpaper"
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="4dp"
            android:clickable="true"
            android:contentDescription="@string/title_wallpaper"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/big_" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/myfont"
                    android:gravity="center"
                    android:text="@string/title_wallpaper"
                    android:textColor="@color/textColor"
                    android:textSize="19sp" />

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:src="@drawable/wallpaper_logo" />
            </LinearLayout>
        </FrameLayout>

        <!--
          The Quran tile: taller than the two above, framed in double gold, with the title set
          large in the serif (Naskh) face and an ornamental divider underneath. It is the one
          entry that is a reading surface rather than a design picker, and it now looks like it.
        -->
        <FrameLayout
            android:id="@+id/frameQuran"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_home_tile_quran"
            android:clickable="true"
            android:contentDescription="@string/cd_quran"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_quran"
                    app:tint="@color/tileTitleGold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="@string/tile_quran"
                    android:textColor="@color/tileTitleGold"
                    android:textDirection="rtl"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="108dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_tile_divider"
                    app:tint="@color/tileFrameGoldSoft" />
            </LinearLayout>
        </FrameLayout>

        <!--
          The athkar tile: same size and gold framing as the Quran tile ("big, like the Quran"),
          in burgundy so the two never blur together. The chip inside it is the old golden badge,
          moved out of the page background and into the card it belongs to: it is visible only
          inside the morning / evening window, exactly as before.
        -->
        <FrameLayout
            android:id="@+id/frameAthkar"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_home_tile_athkar"
            android:clickable="true"
            android:contentDescription="@string/cd_athkar_tile"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_athkar"
                    app:tint="@color/tileTitleGold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="@string/tile_athkar"
                    android:textColor="@color/tileTitleGold"
                    android:textDirection="rtl"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/athkarWindowChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_athkar_badge"
                    android:paddingStart="14dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="3dp"
                    android:text="@string/athkar_morning_title"
                    android:textColor="#FF101820"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</ScrollView>
