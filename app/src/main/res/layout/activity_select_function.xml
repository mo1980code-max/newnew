<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/textColor"
    android:gravity="center"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="?attr/actionBarSize"
            android:layout_gravity="end"
            android:layout_margin="10dp">


            <ImageView
                android:id="@+id/tasbeeh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/cd_tasbeeh"
                android:padding="5dp"
                android:src="@drawable/ic_tasbeeh"
                app:tint="@color/adBg" />

            <ImageView
                android:layout_width="10dp"
                android:layout_height="?attr/actionBarSize"
                android:padding="5dp" />

            <ImageView
                android:id="@+id/qibla"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/cd_qibla"
                android:padding="5dp"
                android:src="@drawable/ic_qibla"
                app:tint="@color/adBg" />

            <ImageView
                android:layout_width="10dp"
                android:layout_height="?attr/actionBarSize"
                android:padding="5dp" />

            <ImageView
                android:id="@+id/privacy"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/privacy_settings_content_description"
                android:padding="5dp"
                android:src="@drawable/ic_privacy_shield"
                android:visibility="gone"
                app:tint="@color/adBg" />

            <ImageView
                android:layout_width="10dp"
                android:layout_height="?attr/actionBarSize"
                android:padding="5dp" />

            <ImageView
                android:id="@+id/rateus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/cd_rate"
                android:src="@drawable/star"
                app:tint="@color/adBg" />

            <ImageView
                android:layout_width="10dp"
                android:layout_height="?attr/actionBarSize"
                android:padding="5dp"></ImageView>

            <ImageView
                android:id="@+id/share"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/share_application"
                android:padding="5dp"
                android:src="@drawable/ic_share"
                app:tint="@color/adBg" />

        </LinearLayout>

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">


        <TextView
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:layout_weight="1"
            android:fontFamily="@font/myfont"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/appColor"
            android:textSize="23sp" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/frameClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="35dp"
        android:layout_marginRight="35dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/big_" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center">

            <TextView
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:layout_weight="1"
                android:fontFamily="@font/myfont"
                android:gravity="center"
                android:text="@string/tile_android_clock"
                android:textColor="@color/textColor"
                android:textSize="20sp" />

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:padding="15dp"
                android:src="@drawable/clock_logo" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/frameWallpaper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="35dp"
        android:layout_marginRight="35dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/big_" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center">

            <TextView
                android:layout_width="150dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:layout_weight="1"
                android:fontFamily="@font/myfont"
                android:gravity="center"
                android:text="@string/title_wallpaper"
                android:textColor="@color/textColor"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:adjustViewBounds="true"
                    android:padding="15dp"
                    android:src="@drawable/wallpaper_logo" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
