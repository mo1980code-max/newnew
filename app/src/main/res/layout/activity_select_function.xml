<?xml version="1.0" encoding="utf-8"?>
<!-- Home dashboard. A ScrollView keeps all three primary tools reachable on small phones. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/textColor"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:layout_gravity="end"
            android:gravity="center_vertical|end"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/language"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/cd_language"
                android:padding="5dp"
                android:src="@drawable/ic_language"
                app:tint="@color/adBg" />

            <ImageView
                android:id="@+id/tasbeeh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="7dp"
                android:contentDescription="@string/cd_tasbeeh"
                android:padding="5dp"
                android:src="@drawable/ic_tasbeeh"
                app:tint="@color/adBg" />

            <ImageView
                android:id="@+id/qibla"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="7dp"
                android:contentDescription="@string/cd_qibla"
                android:padding="5dp"
                android:src="@drawable/ic_qibla"
                app:tint="@color/adBg" />

            <ImageView
                android:id="@+id/privacy"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="7dp"
                android:contentDescription="@string/privacy_settings_content_description"
                android:padding="5dp"
                android:src="@drawable/ic_privacy_shield"
                android:visibility="gone"
                app:tint="@color/adBg" />

            <ImageView
                android:id="@+id/rateus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="7dp"
                android:contentDescription="@string/cd_rate"
                android:src="@drawable/star"
                app:tint="@color/adBg" />

            <ImageView
                android:id="@+id/share"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="7dp"
                android:contentDescription="@string/share_application"
                android:padding="5dp"
                android:src="@drawable/ic_share"
                app:tint="@color/adBg" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/myfont"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/appColor"
            android:textSize="23sp" />

        <FrameLayout
            android:id="@+id/frameClock"
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="4dp"
            android:clickable="true"
            android:contentDescription="@string/tile_android_clock"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/big_" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/myfont"
                    android:gravity="center"
                    android:text="@string/tile_android_clock"
                    android:textColor="@color/textColor"
                    android:textSize="19sp" />

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:src="@drawable/clock_logo" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/frameWallpaper"
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="4dp"
            android:clickable="true"
            android:contentDescription="@string/title_wallpaper"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/big_" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/myfont"
                    android:gravity="center"
                    android:text="@string/title_wallpaper"
                    android:textColor="@color/textColor"
                    android:textSize="19sp" />

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:src="@drawable/wallpaper_logo" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/frameQuran"
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_quran_home_tile"
            android:clickable="true"
            android:contentDescription="@string/cd_quran"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="@string/tile_quran"
                    android:textColor="@color/colorWhite"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="@null"
                    android:padding="14dp"
                    android:src="@drawable/ic_quran"
                    app:tint="@color/quranGold" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/athkarBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_athkar_badge"
            android:contentDescription="@string/cd_athkar_badge"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:text="@string/athkar_morning_title"
            android:textColor="#FF101820"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
