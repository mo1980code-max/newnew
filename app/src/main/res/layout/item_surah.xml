<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginTop="5dp"
    android:layout_marginEnd="14dp"
    android:layout_marginBottom="5dp"
    android:background="@drawable/rounded_quran_card"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Surah Number Badge -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/quran_badge_bg">

        <TextView
            android:id="@+id/tvSurahNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/myfont"
            android:text="1"
            android:textColor="#F59E0B"
            android:textSize="15sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Surah Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSurahNameAr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/myfont"
                android:text="الفاتحة"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSurahNameEn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Al-Fatihah"
                android:textColor="#8F9BB3"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSurahType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مكية"
                android:textColor="#ffd479"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="•"
                android:textColor="#8F9BB3"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvAyahCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7 آيات"
                android:textColor="#8F9BB3"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Starting Page Tag -->
    <TextView
        android:id="@+id/tvStartPage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/quran_badge_bg"
        android:fontFamily="@font/myfont"
        android:paddingLeft="10dp"
        android:paddingTop="5dp"
        android:paddingRight="10dp"
        android:paddingBottom="5dp"
        android:text="ص 1"
        android:textColor="#a9abe0"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
