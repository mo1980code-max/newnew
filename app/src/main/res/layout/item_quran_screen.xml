<?xml version="1.0" encoding="utf-8"?>
<!--
  One flipped page of the Mushaf.

  The sheet is drawn by QuranPageView itself (a slice of the laid-out text), so the scroll view
  here is only a safety valve: a canonical page that genuinely does not fit the screen at the
  reader's text size can be scrolled instead of losing its last verse. With
  android:fillViewport the sheet still stretches to the full height, so a short page keeps the
  same paper size as a long one and the background never shows through.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <org.Allah_Clock_Live_Wallpaper.viewUtils.QuranPageView
        android:id="@+id/quranPageView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_quran_page"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp" />
</ScrollView>
