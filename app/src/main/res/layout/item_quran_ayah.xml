<?xml version="1.0" encoding="utf-8"?>
<!-- One continuous Madani-page/surah fragment, NOT one row per ayah. Verse-level spans
     handle taps and saved highlights; no parent click target or forced inter-verse breaks. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quranAyahRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/quranAyahText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:gravity="start|top"
        android:layoutDirection="rtl"
        android:textAlignment="viewStart"
        android:breakStrategy="simple"
        android:hyphenationFrequency="none"
        android:lineSpacingExtra="10dp"
        android:textColor="@color/quranInk"
        android:textDirection="rtl"
        android:textSize="20sp" />
</LinearLayout>
