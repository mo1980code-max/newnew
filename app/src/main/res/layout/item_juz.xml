<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginTop="5dp"
    android:layout_marginEnd="14dp"
    android:layout_marginBottom="5dp"
    android:background="@drawable/rounded_quran_card"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Juz Number Badge -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/quran_badge_bg">

        <TextView
            android:id="@+id/tvJuzNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/myfont"
            android:text="1"
            android:textColor="#F59E0B"
            android:textSize="15sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Juz Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvJuzTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/myfont"
            android:text="الجزء الأول"
            android:textColor="#ffffff"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStartQuote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/myfont"
            android:singleLine="true"
            android:text="«الم»"
            android:textColor="#ffd479"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvStartSurah"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="سورة الفاتحة"
            android:textColor="#8F9BB3"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Starting Page Tag -->
    <TextView
        android:id="@+id/tvJuzPage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/quran_badge_bg"
        android:fontFamily="@font/myfont"
        android:paddingLeft="10dp"
        android:paddingTop="5dp"
        android:paddingRight="10dp"
        android:paddingBottom="5dp"
        android:text="ص 1"
        android:textColor="#a9abe0"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
