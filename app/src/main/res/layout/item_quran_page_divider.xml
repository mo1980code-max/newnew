<?xml version="1.0" encoding="utf-8"?>
<!--
  A Madani page boundary inside the continuous scroll: a hairline with the printed page number in
  the middle, so the reader always knows which of the 604 pages they are on without leaving the
  flow.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="28dp"
    android:paddingTop="10dp"
    android:paddingEnd="28dp"
    android:paddingBottom="10dp">

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:background="@color/quranLine" />

    <TextView
        android:id="@+id/quranPageDividerNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:textColor="@color/quranMuted"
        android:textSize="10sp"
        android:textStyle="bold" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:background="@color/quranLine" />
</LinearLayout>
