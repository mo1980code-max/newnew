<?xml version="1.0" encoding="utf-8"?>
<!--
  Mushaf mode: the complete 604-page Madani Mushaf as one continuous, smooth vertical scroll
  (RecyclerView), with page boundaries marked inside the flow.

  Surahs open with their authentic heading (name + juz), Madani page boundaries are marked by a
  hairline with the printed page number, and the footer carries the page-number pill of the
  position under the reader's finger. The night reading switch and the text-size picker repaint
  in place; a rotation is absorbed by the manifest's configChanges, so the scroll never loses
  its place.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quranMushafRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/quranPaper"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageButton
            android:id="@+id/quranMushafBack"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_quran_icon_button"
            android:contentDescription="@string/cd_back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="@color/quranInk" />

        <TextView
            android:id="@+id/quranMushafTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/myfont"
            android:maxLines="1"
            android:text="@string/title_quran_mushaf"
            android:textColor="@color/quranInk"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/quranMushafNight"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_quran_icon_button"
            android:contentDescription="@string/cd_quran_night_mode"
            android:padding="12dp"
            android:src="@drawable/ic_quran_night"
            app:tint="@color/quranGreen" />

        <!-- The reading wash: the same six backgrounds the surah reader offers. -->
        <ImageButton
            android:id="@+id/quranMushafBackground"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_quran_icon_button"
            android:contentDescription="@string/cd_quran_background"
            android:padding="12dp"
            android:src="@drawable/ic_quran_background"
            app:tint="@color/quranGreen" />

        <ImageButton
            android:id="@+id/quranMushafTextSize"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_quran_icon_button"
            android:contentDescription="@string/cd_quran_text_size"
            android:padding="12dp"
            android:src="@drawable/ic_text_size"
            app:tint="@color/quranGreen" />

        <ImageButton
            android:id="@+id/quranMushafBookmarks"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_quran_icon_button"
            android:contentDescription="@string/cd_quran_bookmarks"
            android:padding="12dp"
            android:src="@drawable/ic_bookmarks"
            app:tint="@color/quranGreen" />
    </LinearLayout>

    <!-- The authentic Mushaf header: the surah the reader is in and its juz. -->
    <LinearLayout
        android:id="@+id/quranMushafHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_quran_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="13dp"
        android:paddingEnd="16dp"
        android:paddingBottom="11dp">

        <TextView
            android:id="@+id/quranMushafSurahName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:gravity="center"
            android:textColor="@color/quranInk"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quranMushafJuz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_quran_tag"
            android:clickable="true"
            android:contentDescription="@string/cd_quran_choose_juz"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:textColor="@color/quranGreenDark"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quranMushafHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/quran_mushaf_hint"
            android:textColor="@color/quranMuted"
            android:textSize="10sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/quranMushafList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/quranMushafLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="@color/quranGreen" />
        </LinearLayout>

        <TextView
            android:id="@+id/quranMushafError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="28dp"
            android:gravity="center"
            android:text="@string/quran_load_failed"
            android:textColor="@color/quranMuted"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- The footer: the Madani page-number pill of the position the reader is on. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/quranMushafPagePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_quran_tag"
            android:clickable="true"
            android:contentDescription="@string/cd_quran_choose_page"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="132dp"
            android:paddingStart="18dp"
            android:paddingTop="7dp"
            android:paddingEnd="18dp"
            android:paddingBottom="7dp"
            android:textColor="@color/quranGreenDark"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- The gold chip of an ayah of prostration: only the fifteen pages that carry one
             show it, and tapping it explains the sajdah and offers to jump to the ayah. -->
        <TextView
            android:id="@+id/quranMushafSajdah"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_quran_tag"
            android:contentDescription="@string/cd_quran_sajdah"
            android:drawableStart="@drawable/ic_quran_sajdah"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp"
            android:text="@string/quran_sajdah_chip"
            android:textColor="@color/quranGreenDark"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
