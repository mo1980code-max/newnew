<?xml version="1.0" encoding="utf-8"?>
<!--
  Mushaf mode: the canonical 604 pages, flipped sideways by a ViewPager2 instead of a scrolling
  list. Each page is drawn by QuranPageView from QuranTheme, so the night reading switch and the
  text-size picker affect the whole screen without changing the printed page boundaries.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quranMushafRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/quranPaper"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/quranMushafBack"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_quran_icon_button"
            android:contentDescription="@string/cd_back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="@color/quranInk" />

        <TextView
            android:id="@+id/quranMushafTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/myfont"
            android:maxLines="1"
            android:text="@string/title_quran_mushaf"
            android:textColor="@color/quranInk"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/quranMushafNight"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_quran_icon_button"
            android:contentDescription="@string/cd_quran_night_mode"
            android:padding="12dp"
            android:src="@drawable/ic_quran_night"
            app:tint="@color/quranGreen" />

        <ImageButton
            android:id="@+id/quranMushafTextSize"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_quran_icon_button"
            android:contentDescription="@string/cd_quran_text_size"
            android:padding="12dp"
            android:src="@drawable/ic_text_size"
            app:tint="@color/quranGreen" />

        <ImageButton
            android:id="@+id/quranMushafBookmarks"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_quran_icon_button"
            android:contentDescription="@string/cd_quran_bookmarks"
            android:padding="12dp"
            android:src="@drawable/ic_bookmarks"
            app:tint="@color/quranGreen" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quranMushafHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_quran_card"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="9dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/quranMushafPrevious"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_quran_page_button"
                android:contentDescription="@string/cd_quran_previous_page"
                android:text="@string/quran_previous_page"
                android:textAllCaps="false"
                android:textColor="@color/quranGreenDark"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/quranMushafPageLabel"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1.25"
                android:background="@drawable/bg_quran_tag"
                android:clickable="true"
                android:contentDescription="@string/cd_quran_choose_page"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:textColor="@color/quranGreenDark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/quranMushafNext"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_quran_page_button"
                android:contentDescription="@string/cd_quran_next_page"
                android:text="@string/quran_next_page"
                android:textAllCaps="false"
                android:textColor="@color/quranGreenDark"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/quranMushafRange"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/quranMuted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/quranMushafJuz"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_quran_tag"
                android:clickable="true"
                android:contentDescription="@string/cd_quran_choose_juz"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:minWidth="70dp"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:textColor="@color/quranGreenDark"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/quranMushafPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/quranMushafLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="@color/quranGreen" />
        </LinearLayout>

        <TextView
            android:id="@+id/quranMushafError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="28dp"
            android:gravity="center"
            android:text="@string/quran_load_failed"
            android:textColor="@color/quranMuted"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/quranMushafSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="7dp"
        android:gravity="center"
        android:text="@string/quran_text_source_short"
        android:textColor="@color/quranMuted"
        android:textSize="10sp" />
</LinearLayout>
