<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#14142b"
    android:orientation="vertical">

    <!-- Top Action Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1b1b3a"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            app:tint="#ffffff" />

        <TextView
            android:id="@+id/tvTasbihHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/myfont"
            android:text="@string/menu_tasbih"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnHeaderShare"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/share_app"
            android:padding="8dp"
            android:src="@drawable/ic_share"
            app:tint="#ffffff" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Today's Occasion Banner -->
            <LinearLayout
                android:id="@+id/cardOccasion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/rounded_tasbih_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_mosque"
                        app:tint="#ffd479" />

                    <TextView
                        android:id="@+id/tvOccasionBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/pill_selected"
                        android:fontFamily="@font/myfont"
                        android:paddingLeft="10dp"
                        android:paddingTop="3dp"
                        android:paddingRight="10dp"
                        android:paddingBottom="3dp"
                        android:text="مناسبة اليوم"
                        android:textColor="#ffffff"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHijriDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="#a9abe0"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvOccasionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/myfont"
                    android:textColor="#ffd479"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOccasionVirtue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="#e0e0ff"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnApplyOccasionDhikr"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/pill_selected"
                    android:fontFamily="@font/myfont"
                    android:text="@string/tasbih_use_occasion_dhikr"
                    android:textColor="#ffffff"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Main Tasbih Counter Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/rounded_tasbih_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Horizontal Dhikr Selector -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutDhikrPills"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- Current Dhikr Display -->
                <TextView
                    android:id="@+id/tvCurrentDhikr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/myfont"
                    android:gravity="center"
                    android:minLines="2"
                    android:text="سبحان الله وبحمده، سبحان الله العظيم"
                    android:textColor="#ffffff"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Large Circular Clickable Button -->
                <FrameLayout
                    android:id="@+id/btnTasbihTap"
                    android:layout_width="190dp"
                    android:layout_height="190dp"
                    android:layout_margin="12dp"
                    android:background="@drawable/tasbih_circle_btn"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCountBig"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/myfont"
                            android:text="0"
                            android:textColor="#ffffff"
                            android:textSize="54sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTargetProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="الهدف: 33"
                            android:textColor="#c9ccff"
                            android:textSize="13sp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Lap Counter & Quick Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvLapCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/pill_unselected"
                        android:paddingLeft="12dp"
                        android:paddingTop="4dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="4dp"
                        android:text="الدورة: 1"
                        android:textColor="#8f94ff"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/tvTodaySummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/pill_unselected"
                        android:paddingLeft="12dp"
                        android:paddingTop="4dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="4dp"
                        android:text="اليوم: 0"
                        android:textColor="#5fe08f"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Control Buttons (Targets, Reset, Vibe) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnTarget33"
                        android:layout_width="54dp"
                        android:layout_height="38dp"
                        android:background="@drawable/pill_selected"
                        android:text="33"
                        android:textColor="#ffffff"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnTarget100"
                        android:layout_width="54dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/pill_unselected"
                        android:text="100"
                        android:textColor="#ffffff"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnTargetOpen"
                        android:layout_width="54dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/pill_unselected"
                        android:text="@string/tasbih_target_open"
                        android:textColor="#ffffff"
                        android:textSize="12sp" />

                    <ImageButton
                        android:id="@+id/btnToggleVibe"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/pill_unselected"
                        android:contentDescription="Vibration"
                        android:padding="8dp"
                        android:src="@drawable/ic_vibrate"
                        app:tint="#8f94ff" />

                    <ImageButton
                        android:id="@+id/btnResetCount"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/pill_unselected"
                        android:contentDescription="Reset"
                        android:padding="8dp"
                        android:src="@drawable/ic_reset"
                        app:tint="#ff6b6b" />
                </LinearLayout>
            </LinearLayout>

            <!-- Statistics & Weekly Record Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/rounded_tasbih_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_stats"
                        app:tint="#8f94ff" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/myfont"
                        android:text="@string/tasbih_stats_title"
                        android:textColor="#ffffff"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Stat Tiles (4 grid items) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/pill_unselected"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvStatToday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/myfont"
                            android:text="0"
                            android:textColor="#5fe08f"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tasbih_stat_today"
                            android:textColor="#a9abe0"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/pill_unselected"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvStatWeek"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/myfont"
                            android:text="0"
                            android:textColor="#8f94ff"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tasbih_stat_week"
                            android:textColor="#a9abe0"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/pill_unselected"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvStatMonth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/myfont"
                            android:text="0"
                            android:textColor="#ffd479"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tasbih_stat_month"
                            android:textColor="#a9abe0"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/pill_unselected"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvStatStreak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/myfont"
                            android:text="0 🔥"
                            android:textColor="#ff7675"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tasbih_stat_streak"
                            android:textColor="#a9abe0"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 7-Day Visual Bars Container -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/tasbih_weekly_chart"
                    android:textColor="#c9ccff"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layoutWeeklyBars"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:gravity="bottom"
                    android:orientation="horizontal" />

                <!-- Action / Export Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnShareReport"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/pill_selected"
                        android:fontFamily="@font/myfont"
                        android:text="@string/tasbih_export_text"
                        android:textColor="#ffffff"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnExportCsv"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/pill_unselected"
                        android:fontFamily="@font/myfont"
                        android:text="@string/tasbih_export_csv"
                        android:textColor="#ffffff"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btnClearStats"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/pill_unselected"
                        android:contentDescription="Clear Stats"
                        android:padding="10dp"
                        android:src="@drawable/ic_cancel"
                        app:tint="#ff6b6b" />
                </LinearLayout>
            </LinearLayout>

            <!-- All Occasions & Days Athkar Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_tasbih_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_mosque"
                        app:tint="#8f94ff" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/myfont"
                        android:text="@string/occasions_all_title"
                        android:textColor="#ffffff"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutOccasionsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
