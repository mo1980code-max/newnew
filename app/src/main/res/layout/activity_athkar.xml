<?xml version="1.0" encoding="utf-8"?>
<!--
  The athkar reader as a classic paper page: opaque, monochrome, no live wallpaper
  behind it and no bottom-sheet chrome. UiCompat.applyEdgeToEdge() keeps the top bar
  clear of the status bar, and AthkarActivity paints the window background with the
  same paper so the system-bar area does not show a different colour.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/athkarRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/athkarPaper"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/athkarClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_athkar_close"
            android:padding="16dp"
            android:src="@drawable/ic_cancel" />

        <TextView
            android:id="@+id/athkarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/myfont"
            android:maxLines="1"
            android:text="@string/athkar_morning_title"
            android:textColor="@color/athkarInk"
            android:textSize="19sp" />

        <!-- How many athkar this list holds: 31 in the morning, 30 in the evening. -->
        <TextView
            android:id="@+id/athkarCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/athkarMuted"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/athkarSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/athkar_settings"
            android:padding="13dp"
            android:src="@drawable/ic_options"
            android:tint="@color/athkarInk" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/athkarHairline" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/athkarList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="10dp"
        android:scrollbars="vertical" />
</LinearLayout>
