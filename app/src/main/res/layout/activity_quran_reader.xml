<?xml version="1.0" encoding="utf-8"?>
<!--
  A calm, text-first Quran reader. Verse content is supplied from a local read-only asset.

  The verses are laid out the way a Mushaf page lays them out: one continuous run of text, each
  verse closed by the end-of-ayah glyph (U+06DD) carrying its own Arabic-Indic number, instead
  of one bordered card per ayah. Tapping a verse saves or clears its bookmark, and the verse is
  tinted while it stays saved.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/quranPaper"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/quranReaderBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_quran_icon_button"
            android:contentDescription="@string/cd_back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="@color/quranInk" />

        <TextView
            android:id="@+id/quranReaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/myfont"
            android:maxLines="1"
            android:textColor="@color/quranInk"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/quranReaderTextSize"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_quran_icon_button"
            android:contentDescription="@string/cd_quran_text_size"
            android:padding="12dp"
            android:src="@drawable/ic_text_size"
            app:tint="@color/quranGreen" />

        <ImageButton
            android:id="@+id/quranReaderMushaf"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_quran_icon_button"
            android:contentDescription="@string/cd_quran_mushaf"
            android:padding="12dp"
            android:src="@drawable/ic_quran"
            app:tint="@color/quranGreen" />

        <ImageButton
            android:id="@+id/quranReaderBookmarks"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_quran_icon_button"
            android:contentDescription="@string/cd_quran_bookmarks"
            android:padding="12dp"
            android:src="@drawable/ic_bookmarks"
            app:tint="@color/quranGreen" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quranReaderHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_quran_card"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/quranReaderMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/quranMuted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/quranReaderHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/quran_reader_hint"
            android:textColor="@color/quranBody"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/quranReaderScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="none">

            <TextView
                android:id="@+id/quranReaderPage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_quran_page"
                android:fontFamily="serif"
                android:justificationMode="inter_word"
                android:lineSpacingExtra="12dp"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="16dp"
                android:textColor="@color/quranInk"
                android:textDirection="rtl"
                android:textSize="23sp"
                tools:targetApi="o" />

        </ScrollView>

        <LinearLayout
            android:id="@+id/quranReaderLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="@color/quranGreen" />
        </LinearLayout>

        <TextView
            android:id="@+id/quranReaderError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="28dp"
            android:gravity="center"
            android:text="@string/quran_load_failed"
            android:textColor="@color/quranMuted"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="7dp"
        android:gravity="center"
        android:text="@string/quran_text_source_short"
        android:textColor="@color/quranMuted"
        android:textSize="10sp" />
</LinearLayout>
