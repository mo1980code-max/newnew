<?xml version="1.0" encoding="utf-8"?>
<!--
  The Quran reader: a Mushaf you flip, not a column you scroll.

  Verses are laid out as one continuous run of text - each closed by the numbered end-of-ayah
  ornament - and the run is cut into screen-sized pages by QuranPaginator. The ViewPager2 below
  turns those pages horizontally, in both directions, exactly like the printed book; the sheet,
  the ornaments and every colour come from QuranTheme, so the night reading switch changes the
  whole screen in place without the page being rebuilt.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quranReaderRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/quranPaper"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/quranReaderBack"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_quran_icon_button"
            android:contentDescription="@string/cd_back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="@color/quranInk" />

        <TextView
            android:id="@+id/quranReaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/myfont"
            android:maxLines="1"
            android:textColor="@color/quranInk"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/quranReaderNight"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_quran_icon_button"
            android:contentDescription="@string/cd_quran_night_mode"
            android:padding="12dp"
            android:src="@drawable/ic_quran_night"
            app:tint="@color/quranGreen" />

        <ImageButton
            android:id="@+id/quranReaderTextSize"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_quran_icon_button"
            android:contentDescription="@string/cd_quran_text_size"
            android:padding="12dp"
            android:src="@drawable/ic_text_size"
            app:tint="@color/quranGreen" />

        <ImageButton
            android:id="@+id/quranReaderBookmarks"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_quran_icon_button"
            android:contentDescription="@string/cd_quran_bookmarks"
            android:padding="12dp"
            android:src="@drawable/ic_bookmarks"
            app:tint="@color/quranGreen" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quranReaderHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_quran_card"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/quranReaderMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/quranMuted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/quranReaderHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/quran_flip_hint"
            android:textColor="@color/quranBody"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/quranReaderPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/quranReaderLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="@color/quranGreen" />
        </LinearLayout>

        <TextView
            android:id="@+id/quranReaderError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="28dp"
            android:gravity="center"
            android:text="@string/quran_load_failed"
            android:textColor="@color/quranMuted"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

    <!--
      Turning the page by button as well as by swipe: a reader with wet or shaky hands, or one
      who simply prefers a control, gets the same journey. The centre label states which ayahs
      the open page carries, so a flipped page can never lose the reader's place.
    -->
    <LinearLayout
        android:id="@+id/quranReaderFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_quran_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/quranReaderPrevious"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_quran_page_button"
            android:text="@string/quran_previous_page"
            android:textAllCaps="false"
            android:textColor="@color/quranGreenDark"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/quranReaderRange"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1.3"
            android:background="@drawable/bg_quran_tag"
            android:gravity="center"
            android:textColor="@color/quranGreenDark"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/quranReaderNext"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_quran_page_button"
            android:text="@string/quran_next_page"
            android:textAllCaps="false"
            android:textColor="@color/quranGreenDark"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/quranReaderMushaf"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_quran_icon_button"
            android:contentDescription="@string/cd_quran_mushaf"
            android:padding="9dp"
            android:src="@drawable/ic_quran"
            app:tint="@color/quranGold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/quran_text_source_short"
            android:textColor="@color/quranMuted"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
