<?xml version="1.0" encoding="utf-8"?>
<!--
  The Quran reader: one surah as one continuous, smooth vertical scroll (RecyclerView).

  The authentic Mushaf header opens the screen: the surah's name and its juz. The verses run as
  one flowing column, each closed by its built-in end-of-ayah glyph, and the footer carries the
  page-number pill — the Madani page of the verse under the reader's finger, updated while they
  scroll. The night reading switch and the text-size picker repaint in place; a rotation is
  absorbed by the manifest's configChanges, so the scroll never loses its place.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quranReaderRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/quranPaper"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageButton
            android:id="@+id/quranReaderBack"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_quran_icon_button"
            android:contentDescription="@string/cd_back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="@color/quranInk" />

        <TextView
            android:id="@+id/quranReaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/myfont"
            android:maxLines="1"
            android:textColor="@color/quranInk"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/quranReaderNight"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_quran_icon_button"
            android:contentDescription="@string/cd_quran_night_mode"
            android:padding="12dp"
            android:src="@drawable/ic_quran_night"
            app:tint="@color/quranGreen" />

        <!-- The reading wash: six paper/night backgrounds, chosen in place and remembered. -->
        <ImageButton
            android:id="@+id/quranReaderBackground"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_quran_icon_button"
            android:contentDescription="@string/cd_quran_background"
            android:padding="12dp"
            android:src="@drawable/ic_quran_background"
            app:tint="@color/quranGreen" />

        <ImageButton
            android:id="@+id/quranReaderTextSize"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_quran_icon_button"
            android:contentDescription="@string/cd_quran_text_size"
            android:padding="12dp"
            android:src="@drawable/ic_text_size"
            app:tint="@color/quranGreen" />

        <ImageButton
            android:id="@+id/quranReaderBookmarks"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_quran_icon_button"
            android:contentDescription="@string/cd_quran_bookmarks"
            android:padding="12dp"
            android:src="@drawable/ic_bookmarks"
            app:tint="@color/quranGreen" />
    </LinearLayout>

    <!-- The authentic Mushaf header: the surah's name and its juz. -->
    <LinearLayout
        android:id="@+id/quranReaderHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_quran_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="13dp"
        android:paddingEnd="16dp"
        android:paddingBottom="13dp">

        <TextView
            android:id="@+id/quranReaderSurahName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:gravity="center"
            android:textColor="@color/quranInk"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quranReaderJuz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_quran_tag"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:textColor="@color/quranGreenDark"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quranReaderMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/quranMuted"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/quranReaderList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/quranReaderLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="@color/quranGreen" />
        </LinearLayout>

        <TextView
            android:id="@+id/quranReaderError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="28dp"
            android:gravity="center"
            android:text="@string/quran_load_failed"
            android:textColor="@color/quranMuted"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- The footer: the Madani page-number pill of the verse the reader is on, and the gold
         chip that appears only on the fifteen pages carrying an ayah of prostration. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/quranReaderPagePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_quran_tag"
            android:gravity="center"
            android:minWidth="132dp"
            android:paddingStart="18dp"
            android:paddingTop="7dp"
            android:paddingEnd="18dp"
            android:paddingBottom="7dp"
            android:textColor="@color/quranGreenDark"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quranReaderSajdah"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_quran_tag"
            android:contentDescription="@string/cd_quran_sajdah"
            android:drawableStart="@drawable/ic_quran_sajdah"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp"
            android:text="@string/quran_sajdah_chip"
            android:textColor="@color/quranGreenDark"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
