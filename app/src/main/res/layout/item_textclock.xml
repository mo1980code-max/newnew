<?xml version="1.0" encoding="utf-8"?>
<com.clock.livewallpaper.viewUtils.SquareRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:layout_margin="10dp"
    app:cardBackgroundColor="@color/themeDarkColor"
    app:cardCornerRadius="15dp"
    app:cardUseCompatPadding="true">

    <ImageView
        android:id="@+id/clockwise"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center"
        android:padding="15dp" />
</com.clock.livewallpaper.viewUtils.SquareRelativeLayout>
