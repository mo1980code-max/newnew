<?xml version="1.0" encoding="utf-8"?>
<!--
  One dhikr on the paper page.

  The whole block is the tap target - there is no counter circle any more. Each tap
  decrements the number printed beside the text, and the header row repeats it as
  "remaining / total". Monochrome on purpose: ink for the dhikr, body grey for the
  translation, muted grey for the reward note and the small print, a hairline between
  two athkar. The only state change is the block fading once the dhikr is completed.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/athkarCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="13dp"
        android:paddingEnd="16dp"
        android:paddingBottom="13dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Position in the list, the way the source numbers its athkar. -->
            <TextView
                android:id="@+id/athkarIndex"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/athkarMuted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Remaining / total, e.g. 3 / 3. -->
            <TextView
                android:id="@+id/athkarProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:textColor="@color/athkarMuted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/athkarDone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/athkar_completed"
                android:textColor="@color/athkarMuted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">

            <!-- The count, printed beside the dhikr instead of inside a circle. -->
            <TextView
                android:id="@+id/athkarCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/cd_athkar_counter"
                android:gravity="center_horizontal"
                android:minWidth="26dp"
                android:textColor="@color/athkarInk"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/athkarArabic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:lineSpacingExtra="8dp"
                android:textColor="@color/athkarInk"
                android:textDirection="rtl"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/athkarTransliteration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/athkarSoft"
            android:textDirection="ltr"
            android:textSize="12sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/athkarEnglish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/athkarBody"
            android:textDirection="ltr"
            android:textSize="13sp" />

        <!-- Reward note printed under the dhikr on the source site. Hidden when there is none. -->
        <TextView
            android:id="@+id/athkarVirtue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/athkarMuted"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/athkarReference"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/athkarSoft"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/athkarHairline" />
</LinearLayout>
