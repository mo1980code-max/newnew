<?xml version="1.0" encoding="utf-8"?>
<!--
  One dhikr of the morning / evening reader.

  The whole dhikr is a rounded CardView (16 dp corners) on light cream (#FDFBF7) with Arabic
  typography, and its bottom edge is an earthy taupe (#B5ABA1) dock bar: a white circular share
  button beside "مشاركة" and the "التكرار" label beside a white circular counter badge holding
  the repeats still to do. Tapping the card does one count; a finished dhikr settles into the
  muted completed tones (#E8E5DF card, #8E8880 dock, #8A857F text) which the adapter paints.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="5dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="5dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/athkarCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/athkarCardCream"
        app:cardCornerRadius="16dp"
        app:cardElevation="1.5dp"
        app:cardPreventCornerOverlap="true"
        app:contentPadding="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/athkarIndex"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/athkarMuted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/athkarProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/athkarSoft"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/athkarDone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/athkar_completed"
                    android:textColor="@color/athkarSoft"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/athkarArabic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:lineSpacingExtra="6dp"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:textColor="@color/athkarInk"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/athkarTransliteration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontStyle="italic"
                android:paddingStart="16dp"
                android:paddingTop="2dp"
                android:paddingEnd="16dp"
                android:textColor="@color/athkarBody"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/athkarEnglish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:textColor="@color/athkarBody"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/athkarVirtue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontStyle="italic"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:textColor="@color/athkarMuted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/athkarReference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:textColor="@color/athkarSoft"
                android:textSize="12sp" />

            <!-- The earthy taupe dock: share on one side, the remaining-count badge on the
                 other. The card's 16 dp corner radius clips the dock's bottom corners for it. -->
            <LinearLayout
                android:id="@+id/athkarDock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/athkarDockTaupe"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/athkarShareLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/athkar_share"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:id="@+id/athkarShareButton"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_athkar_circle_white">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/athkar_cd_share"
                            android:src="@drawable/ic_share"
                            app:tint="@color/athkarDockTaupe" />
                    </FrameLayout>
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/athkarRepeatLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/athkar_repeat"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:id="@+id/athkarCountBadge"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_athkar_circle_white"
                        android:contentDescription="@string/cd_athkar_counter">

                        <TextView
                            android:id="@+id/athkarCount"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textColor="@color/athkarInk"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
