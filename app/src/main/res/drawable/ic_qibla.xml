<?xml version="1.0" encoding="utf-8"?>
<!--
  Qibla compass, refined: the dial ring with its cardinal ticks and a golden needle.

  The old glyph was a plain cube; this one says what the button actually opens - the compass that
  points to the Kaaba - and matches the misbaha and the globe next to it: thin ivory lines, one
  golden accent (the needle), nothing filled solid.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- the dial -->
    <path
        android:fillColor="#00000000"
        android:pathData="M12,2.6 a9.4,9.4 0 1,0 0.01,0 z"
        android:strokeColor="#FFF3E7CB"
        android:strokeWidth="1.35" />

    <!-- the inner graduation ring, faint -->
    <path
        android:fillColor="#00000000"
        android:pathData="M12,5.4 a6.6,6.6 0 1,0 0.01,0 z"
        android:strokeColor="#80F3E7CB"
        android:strokeWidth="0.8" />

    <!-- the four cardinal ticks -->
    <path
        android:fillColor="#00000000"
        android:pathData="M12,1.5 v1.9 M12,20.6 v1.9 M1.5,12 h1.9 M20.6,12 h1.9"
        android:strokeColor="#FFF3E7CB"
        android:strokeLineCap="round"
        android:strokeWidth="1.4" />

    <!-- the needle: north in gold, south in ivory, the way a real compass is painted -->
    <path
        android:fillColor="#FFE9CE8A"
        android:pathData="M12,6.2 L14.1,12 L12,16 L9.9,12 Z" />
    <path
        android:fillColor="#80F3E7CB"
        android:pathData="M12,6.2 L9.9,12 L12,12 Z" />

    <!-- the pivot -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,11 a1.05,1.05 0 1,0 0.01,0 z" />
</vector>
