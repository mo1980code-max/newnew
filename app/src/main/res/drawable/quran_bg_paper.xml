<?xml version="1.0" encoding="utf-8"?>
<!--
  The paper wash: near-white with a warm fall towards the foot of the page.

  Three layers, all plain shapes so it draws identically on API 23 and on the newest Android:
  the wash itself (a vertical gradient of the palette's paper), a faint gold light falling from
  the top of the page like a lamp above the Mushaf, and the double hairline frame a printed
  Mushaf page carries. QuranTheme.backgroundOf() is what picks this file.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#F4EDDD"
                android:startColor="#FFFDFA"
                android:type="linear" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#00000000"
                android:centerY="0.38"
                android:endColor="#00000000"
                android:startColor="#14BA8B36"
                android:type="linear" />
        </shape>
    </item>

    <item>
        <inset
            android:insetBottom="9dp"
            android:insetLeft="9dp"
            android:insetRight="9dp"
            android:insetTop="9dp">
            <shape android:shape="rectangle">
                <corners android:radius="18dp" />
                <stroke
                    android:width="1dp"
                    android:color="#22B07D2B" />
            </shape>
        </inset>
    </item>

    <item>
        <inset
            android:insetBottom="14dp"
            android:insetLeft="14dp"
            android:insetRight="14dp"
            android:insetTop="14dp">
            <shape android:shape="rectangle">
                <corners android:radius="14dp" />
                <stroke
                    android:width="1dp"
                    android:color="#12B07D2B" />
            </shape>
        </inset>
    </item>
</layer-list>
