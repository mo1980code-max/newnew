<?xml version="1.0" encoding="utf-8"?>
<!--
  Language, refined: a globe drawn as thin lines with a golden arc across its upper hemisphere.
  Lines instead of a solid disc keep it readable at 24 dp inside a frosted tile, and the gold arc
  gives it the same metallic accent as the misbaha and the compass beside it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- the globe -->
    <path
        android:fillColor="#00000000"
        android:pathData="M12,3.2 a8.8,8.8 0 1,0 0.01,0 z"
        android:strokeColor="#FFF3E7CB"
        android:strokeWidth="1.35" />

    <!-- the equator, an ellipse seen edge on -->
    <path
        android:fillColor="#00000000"
        android:pathData="M3.4,12 c2.6,1.7 14.6,1.7 17.2,0 c-2.6,-1.7 -14.6,-1.7 -17.2,0 z"
        android:strokeColor="#FFF3E7CB"
        android:strokeWidth="1.2" />

    <!-- the meridian -->
    <path
        android:fillColor="#00000000"
        android:pathData="M12,3.2 c-4.3,4.9 -4.3,12.7 0,17.6 c4.3,-4.9 4.3,-12.7 0,-17.6 z"
        android:strokeColor="#FFF3E7CB"
        android:strokeWidth="1.2" />

    <!-- the golden arc -->
    <path
        android:fillColor="#00000000"
        android:pathData="M4.3,6.6 c4.8,2.4 10.6,2.4 15.4,0"
        android:strokeColor="#FFE9CE8A"
        android:strokeLineCap="round"
        android:strokeWidth="1.3" />

    <!-- a small golden star, the app's ornament, at the globe's lower right -->
    <path
        android:fillColor="#FFE9CE8A"
        android:pathData="M16.4,15.1 l0.55,1.35 1.35,0.55 -1.35,0.55 -0.55,1.35 -0.55,-1.35 -1.35,-0.55 1.35,-0.55 z" />
</vector>
