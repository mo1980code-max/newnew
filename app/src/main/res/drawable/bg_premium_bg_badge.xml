<?xml version="1.0" encoding="utf-8"?>
<!--
  Gold chip that marks a background as premium. Its look is close to the clocks' badge, so the
  app has one visual language for "this one is special", but it is its own drawable: the wallpaper
  chip sits on a photograph and needs its own scrim to stay readable on a bright image.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/premiumLockScrim" />
    <corners android:radius="9dp" />
    <stroke
        android:width="1dp"
        android:color="@color/premiumLockGold" />
</shape>
