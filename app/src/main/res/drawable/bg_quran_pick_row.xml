<?xml version="1.0" encoding="utf-8"?>
<!--
  One row of the reader's background picker: a soft ripple over a rounded card, tinted at
  runtime by QuranReaderDialogs so it follows whichever wash the dialog was opened in.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#22B07D2B">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#1AB07D2B" />
        </shape>
    </item>
</ripple>
