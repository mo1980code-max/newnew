<?xml version="1.0" encoding="utf-8"?>
<!--
  The continuous reader page. One sheet instead of a card per ayah: a gold hairline frame with
  a second hairline inset, echoing the home tile but in the reader's quiet paper palette.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/quranSurface" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/quranGold" />
        </shape>
    </item>

    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/quranLine" />
        </shape>
    </item>
</layer-list>
