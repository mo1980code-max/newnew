<?xml version="1.0" encoding="utf-8"?>
<!--
  Time-slot chip inside the athkar timing dialog: white on the paper page with a hairline
  border. It replaces bg_athkar_card (translucent white), which was invisible on the light
  AlertDialog the same way the dialog's white labels were invisible on its white background.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
    <stroke
        android:width="1dp"
        android:color="@color/athkarHairline" />
    <corners android:radius="10dp" />
</shape>
