<?xml version="1.0" encoding="utf-8"?>
<!-- The pressed state of a glass tile: the same pane with the gold highlight raised. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:endColor="@color/glassPressedOverlay"
                android:startColor="@color/glassTileTop" />
            <stroke
                android:width="1dp"
                android:color="@color/glassTileGold" />
        </shape>
    </item>
</layer-list>
